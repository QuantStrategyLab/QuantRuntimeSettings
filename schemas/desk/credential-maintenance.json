{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/qsl/desk/credential-maintenance.json",
  "title": "credential-maintenance",
  "description": "API-CONTRACT.md §3.21",
  "type": "object",
  "properties": {
    "id": {"const": "ibkr_flex"},
    "metadata_source": {"const": "operator_provided"},
    "metadata_revision": {"type": "integer", "minimum": 0},
    "expires_at": {
      "anyOf": [{"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Time"}, {"type": "null"}]
    },
    "phase": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Phase"},
    "requires_action": {"type": "boolean"},
    "delivery": {"type": "string", "enum": ["not_reserved", "reserved", "delivered", "unknown"]}
  },
  "required": ["id", "metadata_source", "metadata_revision", "expires_at", "phase", "requires_action", "delivery"],
  "additionalProperties": false
}
