{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/qsl/desk/common.json",
  "$defs": {
    "Time": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "Date": {"type": "string", "format": "date"},
    "Clock": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
    "Decimal": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "Currency": {"type": "string", "pattern": "^[A-Z]{3,4}$"},
    "TargetId": {"type": "string", "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$"},
    "ReadReason": {
      "type": "string",
      "enum": ["never_read", "read_failed", "source_unavailable", "identity_unverified", "not_supported"]
    },
    "RuntimeState": {"type": "string", "enum": ["running", "stopped", "unknown"]},
    "PreflightState": {"type": "string", "enum": ["pass", "warn", "block", "unknown"]},
    "SwitchState": {
      "type": "string",
      "enum": ["scheduled", "dispatched", "applying", "readback_pending", "verified", "mismatch", "unknown", "failed"]
    },
    "Read": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {"const": "known"},
            "value": {},
            "observed_at": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Time"}
          },
          "required": ["status", "value", "observed_at"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {"const": "stale"},
            "value": {},
            "observed_at": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Time"},
            "age_seconds": {"type": "integer", "minimum": 0}
          },
          "required": ["status", "value", "observed_at", "age_seconds"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {"const": "unknown"},
            "reason": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/ReadReason"},
            "observed_at": {
              "anyOf": [{"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Time"}, {"type": "null"}]
            }
          },
          "required": ["status", "reason"],
          "additionalProperties": false
        }
      ]
    },
    "MetricRead": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {"const": "known"},
            "value": {},
            "observed_at": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Time"}
          },
          "required": ["status", "value", "observed_at"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {"const": "stale"},
            "value": {},
            "observed_at": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Time"},
            "age_seconds": {"type": "integer", "minimum": 0}
          },
          "required": ["status", "value", "observed_at", "age_seconds"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {"const": "unknown"},
            "reason": {
              "type": "string",
              "enum": [
                "never_read",
                "read_failed",
                "source_unavailable",
                "identity_unverified",
                "not_supported",
                "insufficient_history"
              ]
            },
            "observed_at": {
              "anyOf": [{"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Time"}, {"type": "null"}]
            }
          },
          "required": ["status", "reason"],
          "additionalProperties": false
        }
      ]
    },
    "Mode": {"type": "string", "enum": ["dry_run", "paper", "live"]},
    "Freshness": {
      "type": "object",
      "properties": {
        "data_status": {"type": "string", "enum": ["ready", "stale", "unavailable"]},
        "age_seconds": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]}
      },
      "required": ["data_status", "age_seconds"],
      "additionalProperties": false
    },
    "ReturnBasis": {"type": "string", "enum": ["native_ibkr_twr", "nav_change_unadjusted", "unavailable"]},
    "PortfolioBasis": {"type": "string", "enum": ["native_ibkr_twr", "nav_change_unadjusted", "mixed", "unavailable"]},
    "Config": {
      "type": "object",
      "properties": {
        "state": {"type": "string", "enum": ["synced", "drift", "unknown"]},
        "drift_count": {"type": "integer", "minimum": 0},
        "checked_at": {
          "anyOf": [{"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Time"}, {"type": "null"}]
        }
      },
      "required": ["state", "drift_count"],
      "additionalProperties": false
    },
    "Outcome": {
      "anyOf": [
        {"type": "string", "enum": ["filled", "orders_submitted", "no_op", "drift", "error", "skipped"]},
        {"type": "null"}
      ]
    },
    "Comparison": {"type": "string", "enum": ["match", "drift", "unknown"]},
    "Severity": {"type": "string", "enum": ["critical", "warning", "info"]},
    "NeedKind": {
      "type": "string",
      "enum": [
        "config_drift",
        "credential_expiring",
        "decision_pending",
        "drawdown_near_limit",
        "run_missed",
        "data_stale",
        "other"
      ]
    },
    "Phase": {"type": "string", "enum": ["unknown", "not_due", "30", "7", "1", "expired"]},
    "CredentialKind": {
      "type": "string",
      "enum": ["oauth_refresh", "flex_token", "access_token", "api_key", "password", "session", "other"]
    },
    "Expiry": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {"const": "known"},
            "at": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Time"},
            "source": {"type": "string"}
          },
          "required": ["status", "at", "source"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {"status": {"const": "none"}},
          "required": ["status"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {"const": "unknown"},
            "reason": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/ReadReason"}
          },
          "required": ["status", "reason"],
          "additionalProperties": false
        }
      ]
    },
    "Strategy": {
      "type": "object",
      "properties": {"profile": {"type": "string"}, "label": {"type": "string"}},
      "required": ["profile", "label"],
      "additionalProperties": false
    },
    "Nav": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {"const": "known"},
            "currency": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Currency"},
            "amount": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Decimal"},
            "usd": {
              "anyOf": [
                {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Decimal"},
                {"type": "null"}
              ]
            },
            "observed_at": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Time"}
          },
          "required": ["status", "currency", "amount", "usd", "observed_at"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {"const": "stale"},
            "currency": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Currency"},
            "amount": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Decimal"},
            "usd": {
              "anyOf": [
                {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Decimal"},
                {"type": "null"}
              ]
            },
            "observed_at": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Time"},
            "age_seconds": {"type": "integer", "minimum": 0}
          },
          "required": ["status", "currency", "amount", "usd", "observed_at", "age_seconds"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {"const": "unknown"},
            "reason": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/ReadReason"},
            "observed_at": {
              "anyOf": [{"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Time"}, {"type": "null"}]
            }
          },
          "required": ["status", "reason"],
          "additionalProperties": false
        }
      ]
    },
    "Benchmark": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {"type": "string", "enum": ["sp500", "nasdaq100", "djia", "russell2000"]},
            "label": {"type": "string"},
            "indexed": {
              "type": "array",
              "items": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Decimal"}
            }
          },
          "required": ["id", "label", "indexed"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {"type": "null"},
            "label": {"type": "null"},
            "indexed": {
              "type": "array",
              "items": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Decimal"},
              "maxItems": 0
            }
          },
          "required": ["id", "label", "indexed"],
          "additionalProperties": false
        }
      ]
    },
    "DisabledAction": {
      "type": "object",
      "properties": {
        "status": {"const": "not_enabled"},
        "allowed": {"const": false},
        "reason_code": {"const": "not_enabled"}
      },
      "required": ["allowed", "reason_code"],
      "additionalProperties": false
    },
    "Preflight": {
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "state": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/PreflightState"},
        "required": {"type": "boolean"},
        "title": {"type": "string"},
        "detail": {"type": "string"},
        "source": {"type": "string"},
        "observed_at": {
          "anyOf": [{"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Time"}, {"type": "null"}]
        }
      },
      "required": ["id", "state", "required", "title", "detail", "source", "observed_at"],
      "additionalProperties": false
    },
    "ReadbackField": {
      "type": "object",
      "properties": {
        "key": {"type": "string"},
        "label": {"type": "string"},
        "saved": {
          "allOf": [
            {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Read"},
            {"type": "object", "properties": {"value": {"type": "string"}}}
          ]
        },
        "platform": {
          "allOf": [
            {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Read"},
            {"type": "object", "properties": {"value": {"type": "string"}}}
          ]
        },
        "state": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Comparison"}
      },
      "required": ["key", "label", "saved", "platform", "state"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"key": {"pattern": "(^|_)(ratio|floor)$|^dca_base_investment_usd$"}},
            "required": ["key"]
          },
          "then": {
            "properties": {
              "saved": {
                "allOf": [
                  {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Read"},
                  {
                    "type": "object",
                    "properties": {"value": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Decimal"}}
                  }
                ]
              },
              "platform": {
                "allOf": [
                  {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Read"},
                  {
                    "type": "object",
                    "properties": {"value": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Decimal"}}
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "VerifyField": {
      "type": "object",
      "properties": {
        "key": {"type": "string"},
        "expected": {"type": "string"},
        "platform": {
          "allOf": [
            {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Read"},
            {"type": "object", "properties": {"value": {"type": "string"}}}
          ]
        },
        "state": {"type": "string", "enum": ["pending", "match", "mismatch", "unknown"]}
      },
      "required": ["key", "expected", "platform", "state"],
      "additionalProperties": false
    },
    "CredentialAction": {
      "if": {"properties": {"phase": {"enum": ["30", "7", "1", "expired"]}}, "required": ["phase"]},
      "then": {"properties": {"requires_action": {"const": true}}},
      "else": {"properties": {"requires_action": {"const": false}}}
    },
    "NullableTime": {
      "anyOf": [
        {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Time"},
        {"type": "null"}
      ]
    },
    "NullableMode": {
      "anyOf": [
        {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Mode"},
        {"type": "null"}
      ]
    },
    "NullableNonNegInt": {
      "anyOf": [
        {"type": "integer", "minimum": 0},
        {"type": "null"}
      ]
    },
    "FleetModeSummary": {
      "type": "object",
      "properties": {
        "status": {"type": "string", "enum": ["single_mode", "mixed", "incomplete", "verified_empty"]},
        "mode": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/NullableMode"},
        "observed_at": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/NullableTime"},
        "cohort_count": {"type": "integer", "minimum": 0},
        "observed_count": {"type": "integer", "minimum": 0},
        "modes": {
          "type": "object",
          "properties": {
            "dry_run": {"type": "integer", "minimum": 0},
            "paper": {"type": "integer", "minimum": 0},
            "live": {"type": "integer", "minimum": 0}
          },
          "required": ["dry_run", "paper", "live"],
          "additionalProperties": false
        },
        "missing_count": {"type": "integer", "minimum": 0},
        "stale_count": {"type": "integer", "minimum": 0},
        "failed_count": {"type": "integer", "minimum": 0},
        "conflict_count": {"type": "integer", "minimum": 0},
        "reasons": {"type": "array", "items": {"type": "string"}},
        "cohort_basis": {"type": "string", "minLength": 1},
        "semantics": {
          "type": "object",
          "properties": {
            "monitoring_only": {"const": true},
            "not_trading_or_books": {"const": true}
          },
          "required": ["monitoring_only", "not_trading_or_books"],
          "additionalProperties": false
        }
      },
      "required": [
        "status",
        "mode",
        "observed_at",
        "cohort_count",
        "observed_count",
        "modes",
        "missing_count",
        "stale_count",
        "failed_count",
        "conflict_count",
        "reasons",
        "cohort_basis",
        "semantics"
      ],
      "additionalProperties": false
    },
    "QueueSource12A": {
      "type": "object",
      "properties": {
        "family": {
          "type": "string",
          "enum": ["owner_decisions", "promotion_applications", "reconciliation_recovery", "credential_maintenance"]
        },
        "status": {"type": "string", "enum": ["ok", "stale", "unavailable", "read_failed"]},
        "observed_at": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/NullableTime"},
        "count": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"},
        "cap": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/NullableNonNegInt"},
        "corrupt_omitted_count": {"type": "integer", "minimum": 0},
        "errors": {"type": "array", "items": {"type": "string"}}
      },
      "required": [
        "family",
        "status",
        "observed_at",
        "count",
        "truncated",
        "cap",
        "corrupt_omitted_count",
        "errors"
      ],
      "additionalProperties": false
    },
    "QueueItem12A": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "family": {
          "type": "string",
          "enum": ["owner_decisions", "promotion_applications", "reconciliation_recovery", "credential_maintenance"]
        },
        "platform": {"type": ["string", "null"]},
        "account_alias": {"type": ["string", "null"]},
        "target_id": {
          "anyOf": [
            {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/TargetId"},
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "status": {"type": "string", "minLength": 1},
        "decision_state": {"type": ["string", "null"]},
        "actionable": {"type": "boolean"},
        "blocked": {"type": "boolean"},
        "expired": {"type": "boolean"},
        "blocker_reasons": {"type": "array", "items": {"type": "string"}},
        "title": {"type": "string"},
        "detail": {"type": ["string", "null"]},
        "observed_at": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/NullableTime"},
        "expires_at": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/NullableTime"},
        "route": {"type": ["string", "null"]}
      },
      "required": [
        "id",
        "family",
        "platform",
        "account_alias",
        "target_id",
        "status",
        "decision_state",
        "actionable",
        "blocked",
        "expired",
        "blocker_reasons",
        "title",
        "detail",
        "observed_at",
        "expires_at",
        "route"
      ],
      "additionalProperties": false
    },
    "OwnerQueue12A": {
      "type": "object",
      "properties": {
        "queue_state": {
          "type": "string",
          "enum": ["non_empty", "verified_empty", "partial_empty", "read_failed"]
        },
        "expected_sources": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["owner_decisions", "promotion_applications", "reconciliation_recovery", "credential_maintenance"]
          }
        },
        "sources": {
          "type": "array",
          "items": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/QueueSource12A"}
        },
        "actionable_items": {
          "type": "array",
          "items": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/QueueItem12A"}
        },
        "blocked_or_expired_items": {
          "type": "array",
          "items": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/QueueItem12A"}
        },
        "total_unresolved": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"},
        "corrupt_omitted_total": {"type": "integer", "minimum": 0},
        "errors": {"type": "array", "items": {"type": "string"}},
        "observed_at": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/NullableTime"}
      },
      "required": [
        "queue_state",
        "expected_sources",
        "sources",
        "actionable_items",
        "blocked_or_expired_items",
        "total_unresolved",
        "truncated",
        "corrupt_omitted_total",
        "errors",
        "observed_at"
      ],
      "additionalProperties": false
    },
    "ReadbackConfigValues": {
      "type": "object",
      "properties": {
        "strategy_profile": {"type": ["string", "null"]},
        "broker_environment": {"type": ["string", "null"]},
        "income_layer_enabled": {"type": ["boolean", "null"]},
        "option_overlay_enabled": {"type": ["boolean", "null"]},
        "reserved_cash_floor": {"type": ["string", "number", "null"]},
        "reserved_cash_ratio": {"type": ["string", "number", "null"]},
        "dca_mode": {"type": ["string", "null"]},
        "dca_base_investment_usd": {"type": ["string", "number", "null"]},
        "enabled": {"type": ["boolean", "null"]},
        "account_selector": {"type": ["string", "null"]},
        "cash_currency": {"type": ["string", "null"]},
        "runtime_status_target_id": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "ReadbackSavedSettings9A": {
      "type": "object",
      "properties": {
        "instance_revision": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/NullableNonNegInt"},
        "draft_revision": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/NullableNonNegInt"},
        "draft_status": {"type": ["string", "null"]},
        "values": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/ReadbackConfigValues"}
      },
      "required": ["instance_revision", "draft_revision", "draft_status", "values"],
      "additionalProperties": false
    },
    "ReadbackPlatformConfiguration9A": {
      "type": "object",
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "read_at": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/NullableTime"},
        "source_as_of": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/NullableTime"},
        "values": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/ReadbackConfigValues"}
      },
      "required": ["source", "read_at", "source_as_of", "values"],
      "additionalProperties": false
    },
    "ReadbackObservedDeployment9A": {
      "type": "object",
      "properties": {
        "data_status": {"type": "string", "enum": ["ready", "stale", "unavailable"]},
        "reason": {"type": ["string", "null"]},
        "observed_at": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/NullableTime"},
        "ttl_seconds": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/NullableNonNegInt"},
        "execution_mode": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/NullableMode"},
        "runtime_enabled": {"type": ["boolean", "null"]},
        "scheduler_state": {"type": "string"},
        "strategy_profile": {"type": ["string", "null"]},
        "semantics": {
          "type": "object",
          "properties": {
            "monitoring_only": {"const": true},
            "not_trading_or_books": {"const": true}
          },
          "required": ["monitoring_only", "not_trading_or_books"],
          "additionalProperties": false
        }
      },
      "required": [
        "data_status",
        "reason",
        "observed_at",
        "ttl_seconds",
        "execution_mode",
        "runtime_enabled",
        "scheduler_state",
        "strategy_profile",
        "semantics"
      ],
      "additionalProperties": false
    },
    "ReadbackLayerComparison9A": {
      "type": "object",
      "properties": {
        "status": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Comparison"},
        "compared_fields": {"type": "array", "items": {"type": "string"}},
        "mismatched_fields": {"type": "array", "items": {"type": "string"}},
        "skipped_non_mutual_fields": {"type": "array", "items": {"type": "string"}},
        "reason": {"type": ["string", "null"]}
      },
      "required": [
        "status",
        "compared_fields",
        "mismatched_fields",
