{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/qsl/desk/credentials.json",
  "title": "credentials",
  "description": "API-CONTRACT.md §3.20",
  "type": "object",
  "properties": {
    "ok": {"const": true},
    "schema_version": {"const": "qsl.desk.credentials.v1"},
    "generated_at": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Time"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "platform": {"type": "string"},
          "label": {"type": "string"},
          "kind": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/CredentialKind"},
          "expiry": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Expiry"},
          "limit_days": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
          "phase": {"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Phase"},
          "requires_action": {"type": "boolean"},
          "rotation": {
            "type": "object",
            "properties": {"supported": {"type": "boolean"}, "route": {"anyOf": [{"type": "string"}, {"type": "null"}]}},
            "required": ["supported", "route"],
            "additionalProperties": false
          },
          "runbook": {"anyOf": [{"type": "string"}, {"type": "null"}]},
          "last_rotated_at": {
            "anyOf": [{"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/Time"}, {"type": "null"}]
          }
        },
        "required": [
          "id",
          "platform",
          "label",
          "kind",
          "expiry",
          "limit_days",
          "phase",
          "requires_action",
          "rotation",
          "runbook",
          "last_rotated_at"
        ],
        "additionalProperties": false,
        "allOf": [{"$ref": "https://schemas.example.invalid/qsl/desk/common.json#/$defs/CredentialAction"}]
      }
    }
  },
  "required": ["ok", "schema_version", "generated_at", "items"],
  "additionalProperties": false
}
