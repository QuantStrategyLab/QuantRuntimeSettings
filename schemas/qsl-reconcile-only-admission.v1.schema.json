{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qsl.reconcile_only_admission.v1",
  "title": "QSL Reconcile-Only Admission v1",
  "description": "A target-bound no-write admission. It is not an order, broker, credential, or account payload.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "admission_id", "created_at", "effective_at", "expires_at", "digest_algorithm", "admission_mode", "target", "admission_sha256"],
  "properties": {
    "schema": {"const": "qsl.reconcile_only_admission.v1"},
    "admission_id": {"$ref": "#/$defs/identity"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "effective_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "digest_algorithm": {"const": "sha256"},
    "admission_mode": {"const": "RECONCILE_ONLY"},
    "target": {"$ref": "#/$defs/target"},
    "admission_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identity": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "target": {"type": "object", "additionalProperties": false, "required": ["platform", "repository", "revision", "environment", "account_alias", "account_digest_sha256"], "properties": {"platform": {"$ref": "#/$defs/identity"}, "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$"}, "revision": {"$ref": "#/$defs/revision"}, "environment": {"$ref": "#/$defs/identity"}, "account_alias": {"$ref": "#/$defs/identity"}, "account_digest_sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
