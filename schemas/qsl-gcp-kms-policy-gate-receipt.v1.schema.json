{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qsl.gcp_kms_policy_gate_receipt.v1",
  "title": "QSL GCP KMS Policy-Gate Receipt v1",
  "description": "A minimal immutable projection of a successful offline GCP KMS policy-gate verification. It does not authorize a runtime, access credentials, submit orders, or replace an independently protected policy gate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "verified_at", "deployment_bundle", "policy", "activation", "target", "risk_control", "trusted_policy_root", "signature_sha256", "receipt_sha256"],
  "properties": {
    "schema": {"const": "qsl.gcp_kms_policy_gate_receipt.v1"},
    "verified_at": {"$ref": "#/$defs/timestamp"},
    "deployment_bundle": {"$ref": "#/$defs/deploymentBundle"},
    "policy": {"$ref": "#/$defs/policy"},
    "activation": {"$ref": "#/$defs/activation"},
    "target": {"$ref": "#/$defs/target"},
    "risk_control": {"$ref": "#/$defs/riskControl"},
    "trusted_policy_root": {"$ref": "#/$defs/trustedPolicyRoot"},
    "signature_sha256": {"$ref": "#/$defs/sha256"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identity": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "deploymentBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "bundle_id", "bundle_sha256"],
      "properties": {
        "schema": {"const": "qsl.deployment_bundle.v1"},
        "bundle_id": {"$ref": "#/$defs/identity"},
        "bundle_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version", "policy_sha256", "stage", "effective_at", "expires_at"],
      "properties": {
        "policy_id": {"$ref": "#/$defs/identity"},
        "policy_version": {"$ref": "#/$defs/identity"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "stage": {"enum": ["DISABLED", "PAPER_DRY_RUN", "SHADOW", "LIMITED_LIVE", "FULL_LIVE"]},
        "effective_at": {"$ref": "#/$defs/timestamp"},
        "expires_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activation_id", "activation_sha256", "effective_at", "expires_at"],
      "properties": {
        "activation_id": {"$ref": "#/$defs/identity"},
        "activation_sha256": {"$ref": "#/$defs/sha256"},
        "effective_at": {"$ref": "#/$defs/timestamp"},
        "expires_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "repository", "revision", "environment", "target_sha256"],
      "properties": {
        "platform": {"$ref": "#/$defs/identity"},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$"},
        "revision": {"$ref": "#/$defs/revision"},
        "environment": {"$ref": "#/$defs/identity"},
        "target_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "riskControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_policy_id", "risk_policy_version", "risk_policy_sha256"],
      "properties": {
        "risk_policy_id": {"$ref": "#/$defs/identity"},
        "risk_policy_version": {"$ref": "#/$defs/identity"},
        "risk_policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "trustedPolicyRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_id", "trusted_policy_root_sha256", "expires_at"],
      "properties": {
        "root_id": {"$ref": "#/$defs/identity"},
        "trusted_policy_root_sha256": {"$ref": "#/$defs/sha256"},
        "expires_at": {"$ref": "#/$defs/timestamp"}
      }
    }
  }
}
