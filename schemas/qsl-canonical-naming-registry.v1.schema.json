{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantstrategylab.github.io/QuantRuntimeSettings/schemas/qsl-canonical-naming-registry.v1.schema.json",
  "title": "QSL Canonical Naming Registry v1 (NAMING-CANONICAL)",
  "description": "Non-breaking canonical naming registry and taxonomy contract (Roadmap v2.0 Item 16). Separates human labels from immutable machine IDs and preserves legacy hashes/keys via legacy_aliases. Grants no migration, rename, deployment, or trading authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "immutable_legacy_hashes",
    "authority",
    "platforms",
    "account_slots",
    "strategies",
    "plugins",
    "risk_tiers",
    "legacy_aliases"
  ],
  "properties": {
    "schema_version": { "const": "qsl.canonical_naming_registry.v1" },
    "immutable_legacy_hashes": { "const": true },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "convention_only",
        "authorizes_rename_or_migration",
        "authorizes_deployment_or_trading"
      ],
      "properties": {
        "convention_only": { "const": true },
        "authorizes_rename_or_migration": { "const": false },
        "authorizes_deployment_or_trading": { "const": false }
      }
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schwab", "firstrade", "ibkr", "longbridge", "binance"],
      "properties": {
        "schwab": { "$ref": "#/$defs/activeOrDormantPlatformEntry" },
        "firstrade": { "$ref": "#/$defs/activeOrDormantPlatformEntry" },
        "ibkr": { "$ref": "#/$defs/activeOrDormantPlatformEntry" },
        "longbridge": { "$ref": "#/$defs/activeOrDormantPlatformEntry" },
        "binance": { "$ref": "#/$defs/dormantPlatformEntry" }
      },
      "allOf": [
        { "properties": { "schwab": { "properties": { "slug": { "const": "schwab" } } } } },
        { "properties": { "firstrade": { "properties": { "slug": { "const": "firstrade" } } } } },
        { "properties": { "ibkr": { "properties": { "slug": { "const": "ibkr" } } } } },
        { "properties": { "longbridge": { "properties": { "slug": { "const": "longbridge" } } } } },
        { "properties": { "binance": { "properties": { "slug": { "const": "binance" } } } } }
      ]
    },
    "account_slots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot_key", "platform", "env", "slot", "synthetic", "label_zh", "label_en"],
        "properties": {
          "slot_key": { "$ref": "#/$defs/accountSlotKey" },
          "platform": { "$ref": "#/$defs/platformSlug" },
          "env": { "$ref": "#/$defs/environment" },
          "slot": { "$ref": "#/$defs/accountSlotPart" },
          "synthetic": { "const": true },
          "label_zh": { "$ref": "#/$defs/humanLabel" },
          "label_en": { "$ref": "#/$defs/humanLabel" }
        }
      }
    },
    "strategies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "strategy_id",
          "market",
          "asset",
          "family",
          "horizon",
          "version",
          "risk_tier",
          "disposition",
          "label_zh",
          "label_en"
        ],
        "properties": {
          "strategy_id": { "$ref": "#/$defs/strategyProfileId" },
          "market": { "enum": ["us", "hk", "global", "crypto"] },
          "asset": { "$ref": "#/$defs/strategySegment" },
          "family": { "$ref": "#/$defs/strategySegment" },
          "horizon": { "$ref": "#/$defs/strategySegment" },
          "version": { "type": "string", "pattern": "^v[0-9]+(?:\\.[0-9]+)*$" },
          "risk_tier": { "$ref": "#/$defs/consoleRiskTier" },
          "disposition": { "enum": ["active_pilot", "phase8_review", "archived"] },
          "label_zh": { "$ref": "#/$defs/humanLabel" },
          "label_en": { "$ref": "#/$defs/humanLabel" }
        }
      }
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plugin_id",
          "capability_class",
          "read_only",
          "can_adjust_risk",
          "max_scalar",
          "can_bypass_fuse",
          "status",
          "label_zh",
          "label_en"
        ],
        "properties": {
          "plugin_id": { "$ref": "#/$defs/pluginId" },
          "capability_class": { "enum": ["observer", "risk_reduction"] },
          "read_only": { "type": "boolean" },
          "can_adjust_risk": { "type": "boolean" },
          "max_scalar": {
            "anyOf": [
              { "type": "number", "minimum": 0, "maximum": 1.0 },
              { "type": "null" }
            ]
          },
          "can_bypass_fuse": { "const": false },
          "status": { "enum": ["active", "shadow_only", "deferred", "archived"] },
          "label_zh": { "$ref": "#/$defs/humanLabel" },
          "label_en": { "$ref": "#/$defs/humanLabel" }
        },
        "allOf": [
          {
            "if": {
              "properties": { "plugin_id": { "pattern": "^obs_" } },
              "required": ["plugin_id"]
            },
            "then": {
              "properties": {
                "capability_class": { "const": "observer" },
                "read_only": { "const": true },
                "can_adjust_risk": { "const": false },
                "max_scalar": { "anyOf": [{ "const": 1.0 }, { "type": "null" }] }
              }
            }
          },
          {
            "if": {
              "properties": { "plugin_id": { "pattern": "^risk_" } },
              "required": ["plugin_id"]
            },
            "then": {
              "properties": {
                "capability_class": { "const": "risk_reduction" },
                "read_only": { "const": false },
                "can_adjust_risk": { "const": true },
                "max_scalar": { "type": "number", "minimum": 0, "maximum": 1.0 }
              }
            }
          }
        ]
      }
    },
    "risk_tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["CAPITAL_PRESERVATION", "BALANCED_COMPOUNDING", "GROWTH_COMPOUNDING"],
      "properties": {
        "CAPITAL_PRESERVATION": {
          "type": "object",
          "additionalProperties": false,
          "required": ["console_tier", "engine_tier", "label_zh", "label_en"],
          "properties": {
            "console_tier": { "const": "CAPITAL_PRESERVATION" },
            "engine_tier": { "const": "conservative" },
            "label_zh": { "$ref": "#/$defs/humanLabel" },
            "label_en": { "$ref": "#/$defs/humanLabel" }
          }
        },
        "BALANCED_COMPOUNDING": {
          "type": "object",
          "additionalProperties": false,
          "required": ["console_tier", "engine_tier", "label_zh", "label_en"],
          "properties": {
            "console_tier": { "const": "BALANCED_COMPOUNDING" },
            "engine_tier": { "const": "balanced" },
            "label_zh": { "$ref": "#/$defs/humanLabel" },
            "label_en": { "$ref": "#/$defs/humanLabel" }
          }
        },
        "GROWTH_COMPOUNDING": {
          "type": "object",
          "additionalProperties": false,
          "required": ["console_tier", "engine_tier", "label_zh", "label_en"],
          "properties": {
            "console_tier": { "const": "GROWTH_COMPOUNDING" },
            "engine_tier": { "const": "aggressive" },
            "label_zh": { "$ref": "#/$defs/humanLabel" },
            "label_en": { "$ref": "#/$defs/humanLabel" }
          }
        }
      }
    },
    "legacy_aliases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platforms", "accounts", "strategies", "plugins"],
      "properties": {
        "platforms": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["legacy_id", "canonical_id"],
            "properties": {
              "legacy_id": { "$ref": "#/$defs/legacyIdentifier" },
              "canonical_id": { "$ref": "#/$defs/platformSlug" }
            }
          }
        },
        "accounts": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["legacy_id", "canonical_id"],
            "properties": {
              "legacy_id": { "$ref": "#/$defs/legacyAccountIdentifier" },
              "canonical_id": { "$ref": "#/$defs/accountSlotKey" }
            }
          }
        },
        "strategies": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["legacy_id", "canonical_id"],
            "properties": {
              "legacy_id": { "$ref": "#/$defs/legacyIdentifier" },
              "canonical_id": { "$ref": "#/$defs/strategyProfileId" }
            }
          }
        },
        "plugins": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["legacy_id", "canonical_id"],
            "properties": {
              "legacy_id": { "$ref": "#/$defs/legacyIdentifier" },
              "canonical_id": { "$ref": "#/$defs/pluginId" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "platformSlug": {
      "type": "string",
      "enum": ["schwab", "firstrade", "ibkr", "longbridge", "binance"]
    },
    "environment": {
      "type": "string",
      "enum": ["live", "paper", "research"]
    },
    "consoleRiskTier": {
      "type": "string",
      "enum": ["CAPITAL_PRESERVATION", "BALANCED_COMPOUNDING", "GROWTH_COMPOUNDING"]
    },
    "humanLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S",
      "not": {
        "anyOf": [
          { "pattern": "(?:^|[^A-Za-z0-9])[dD]?[uU][0-9]{5,}(?:$|[^A-Za-z0-9])" },
          { "pattern": "[0-9](?:[-_ ]?[0-9]){5}" },
          { "pattern": "(?:://|^[A-Za-z][A-Za-z0-9+.-]*:/|(?:^|[\\s:(\\[\"'（])(?:[A-Za-z]:\\\\|~/|/(?:[Uu]sers|[Hh]ome|[Tt]mp|[Vv]ar|[Ee]tc|[Oo]pt|[Mm]nt)/)|\\.\\.[/\\\\]|[?#]|&(?:[Xx]-[Gg]oog-|[Ss]ignature|[Ee]xpires|[Aa][Ww][Ss][Aa]ccess[Kk]ey[Ii]d|token|sig|auth)=)" }
        ]
      }
    },
    "activeOrDormantPlatformEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "status", "label_zh", "label_en"],
      "properties": {
        "slug": { "$ref": "#/$defs/platformSlug" },
        "status": { "enum": ["active", "dormant"] },
        "label_zh": { "$ref": "#/$defs/humanLabel" },
        "label_en": { "$ref": "#/$defs/humanLabel" }
      }
    },
    "dormantPlatformEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "status", "label_zh", "label_en"],
      "properties": {
        "slug": { "$ref": "#/$defs/platformSlug" },
        "status": { "const": "dormant" },
        "label_zh": { "$ref": "#/$defs/humanLabel" },
        "label_en": { "$ref": "#/$defs/humanLabel" }
      }
    },
    "accountSlotPart": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$",
      "not": {
        "anyOf": [
          { "pattern": "(?:^|[^a-z0-9])d?u[0-9]{5,}(?:$|[^a-z0-9])" },
          { "pattern": "[0-9](?:[-_]?[0-9]){5}" }
        ]
      }
    },
    "accountSlotKey": {
      "type": "string",
      "pattern": "^(schwab|firstrade|ibkr|longbridge|binance):(live|paper|research):[a-z0-9][a-z0-9_-]{0,31}$",
      "not": {
        "anyOf": [
          { "pattern": ":(?:[^:]*[^a-z0-9])?d?u[0-9]{5,}(?:$|[^a-z0-9])" },
          { "pattern": ":[^:]*[0-9](?:[-_]?[0-9]){5}" }
        ]
      }
    },
    "strategySegment": {
      "type": "string",
      "pattern": "^[a-z0-9]+$",
      "not": {
        "pattern": "^(?:v[0-9]+|conservative|balanced|aggressive)$"
      }
    },
    "strategyProfileId": {
      "type": "string",
      "pattern": "^(us|hk|global|crypto)_[a-z0-9]+_[a-z0-9]+_[a-z0-9]+$",
      "not": {
        "pattern": "(?:_v[0-9]+(?:_|$)|_(?:conservative|balanced|aggressive|capital_preservation|balanced_compounding|growth_compounding)(?:_|$))"
      }
    },
    "pluginId": {
      "type": "string",
      "pattern": "^(obs|risk)_[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "legacyIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"
    },
    "legacyAccountIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9_:.-]{0,127}$",
      "not": {
        "anyOf": [
          { "pattern": "(?:^|[^a-z0-9])d?u[0-9]{5,}(?:$|[^a-z0-9])" },
          { "pattern": "[0-9](?:[-_.]?[0-9]){5}" }
        ]
      }
    }
  }
}
