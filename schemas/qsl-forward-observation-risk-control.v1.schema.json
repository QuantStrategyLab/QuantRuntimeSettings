{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qsl.forward_observation_risk_control.v1",
  "title": "QSL Forward Observation Risk Control v1",
  "description": "A bounded P4/P5 risk-control payload. It does not authorize a runtime, access credentials, or submit orders.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "risk_policy_id", "risk_policy_version", "created_at", "effective_at", "expires_at", "digest_algorithm", "stage", "execution_lane", "candidate", "source_evidence", "limits", "circuit_breaker", "risk_policy_sha256"],
  "properties": {
    "schema": {"const": "qsl.forward_observation_risk_control.v1"},
    "risk_policy_id": {"$ref": "#/$defs/identity"},
    "risk_policy_version": {"$ref": "#/$defs/identity"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "effective_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "digest_algorithm": {"const": "sha256"},
    "stage": {"enum": ["PAPER_DRY_RUN", "SHADOW"]},
    "execution_lane": {"enum": ["PAPER_BROKER", "SHADOW_LEDGER"]},
    "candidate": {"$ref": "#/$defs/candidate"},
    "source_evidence": {"$ref": "#/$defs/sourceEvidence"},
    "limits": {"$ref": "#/$defs/limits"},
    "circuit_breaker": {"$ref": "#/$defs/circuitBreaker"},
    "risk_policy_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {"if": {"properties": {"stage": {"const": "PAPER_DRY_RUN"}}}, "then": {"properties": {"execution_lane": {"const": "PAPER_BROKER"}}}},
    {"if": {"properties": {"stage": {"const": "SHADOW"}}}, "then": {"properties": {"execution_lane": {"const": "SHADOW_LEDGER"}}}}
  ],
  "$defs": {
    "identity": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "candidate_kind", "domain", "strategy_repository", "strategy_revision"], "properties": {"candidate_id": {"$ref": "#/$defs/identity"}, "candidate_kind": {"enum": ["individual", "combo", "plugin"]}, "domain": {"$ref": "#/$defs/identity"}, "strategy_repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$"}, "strategy_revision": {"$ref": "#/$defs/revision"}}},
    "sourceEvidence": {"type": "object", "additionalProperties": false, "required": ["p1_input_digest", "p2_config_digest", "p3_evidence_id", "producer_revision"], "properties": {"p1_input_digest": {"$ref": "#/$defs/sha256"}, "p2_config_digest": {"$ref": "#/$defs/sha256"}, "p3_evidence_id": {"$ref": "#/$defs/sha256"}, "producer_revision": {"$ref": "#/$defs/revision"}}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["allowed_symbols_sha256", "max_open_positions", "max_gross_notional_cents", "max_single_decision_notional_cents", "max_daily_turnover_notional_cents", "max_decisions_per_session", "max_consecutive_failures"], "properties": {"allowed_symbols_sha256": {"$ref": "#/$defs/sha256"}, "max_open_positions": {"type": "integer", "minimum": 1, "maximum": 100}, "max_gross_notional_cents": {"type": "integer", "minimum": 1, "maximum": 1000000000}, "max_single_decision_notional_cents": {"type": "integer", "minimum": 1, "maximum": 1000000000}, "max_daily_turnover_notional_cents": {"type": "integer", "minimum": 1, "maximum": 4000000000}, "max_decisions_per_session": {"type": "integer", "minimum": 1, "maximum": 64}, "max_consecutive_failures": {"type": "integer", "minimum": 1, "maximum": 10}}},
    "circuitBreaker": {"type": "object", "additionalProperties": false, "required": ["require_market_session", "halt_on_data_unavailable", "halt_on_evidence_mismatch", "halt_on_reconciliation_failure", "halt_on_execution_error", "halt_on_unknown_execution_outcome", "require_reconciliation_before_next_cycle"], "properties": {"require_market_session": {"const": true}, "halt_on_data_unavailable": {"const": true}, "halt_on_evidence_mismatch": {"const": true}, "halt_on_reconciliation_failure": {"const": true}, "halt_on_execution_error": {"const": true}, "halt_on_unknown_execution_outcome": {"const": true}, "require_reconciliation_before_next_cycle": {"const": true}}}
  }
}
