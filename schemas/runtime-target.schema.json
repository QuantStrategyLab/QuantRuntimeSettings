{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QuantStrategyLab/QuantRuntimeSettings/schemas/runtime-target.schema.json",
  "title": "Quant runtime target",
  "type": "object",
  "required": ["target_id", "github", "runtime_target"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "target_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$"
    },
    "description": {
      "type": "string"
    },
    "github": {
      "type": "object",
      "required": ["repository", "variable_scope"],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "variable_scope": {
          "type": "string",
          "enum": ["repository", "environment"]
        },
        "environment": {
          "type": "string"
        }
      }
    },
    "runtime_target": {
      "type": "object",
      "required": [
        "platform_id",
        "strategy_profile",
        "dry_run_only",
        "deployment_selector",
        "account_selector",
        "account_scope",
        "service_name",
        "execution_mode"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"required": ["account_domain", "dry_run_only"], "properties": {
            "dry_run_only": {"const": false},
            "account_domain": {"required": ["policy"], "properties": {"policy": {"required": ["capital_kind"], "properties": {"capital_kind": {"const": "FTMO_SIMULATED"}}}}}
          }},
          "then": {"properties": {"execution_mode": {"const": "paper"}}}
        },
        {
          "if": {"required": ["account_domain", "dry_run_only"], "properties": {
            "dry_run_only": {"const": false},
            "account_domain": {"required": ["policy"], "properties": {"policy": {"required": ["capital_kind"], "properties": {"capital_kind": {"const": "OWN_REAL"}}}}}
          }},
          "then": {"properties": {"execution_mode": {"const": "live"}}}
        }
      ],
      "dependentRequired": {
        "market": ["market_calendar", "market_timezone"],
        "market_calendar": ["market", "market_timezone"],
        "market_timezone": ["market", "market_calendar"]
      },
      "properties": {
        "account_domain": {
          "type": "object", "additionalProperties": false,
          "required": ["identity", "policy"],
          "properties": {
            "identity": {
              "type": "object", "additionalProperties": false,
              "required": ["environment", "platform_id", "server", "account_id_fingerprint", "lifecycle_id"],
              "properties": {
                "environment": {"type": "string", "minLength": 1},
                "platform_id": {"type": "string", "minLength": 1},
                "server": {"type": "string", "minLength": 1},
                "account_id_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                "lifecycle_id": {"type": "string", "minLength": 1}
              }
            },
            "policy": {
              "type": "object", "additionalProperties": false,
              "required": ["capital_kind", "product", "phase", "account_type", "style", "preference", "currency", "source", "effective_at", "valid_until", "version"],
              "properties": {
                "capital_kind": {"enum": ["OWN_REAL", "FTMO_SIMULATED"]},
                "product": {"enum": ["BROKERAGE", "FTMO_CFD_2_STEP"]},
                "phase": {"enum": ["LIVE", "FREE_TRIAL"]},
                "account_type": {"enum": ["CASH", "MARGIN", "STANDARD", "SWING"]},
                "style": {"type": "string", "minLength": 1},
                "preference": {"enum": ["CAPITAL_PRESERVATION", "BALANCED_COMPOUNDING", "GROWTH_COMPOUNDING"]},
                "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
                "source": {"type": "string", "minLength": 1},
                "effective_at": {"type": "string", "format": "date-time"},
                "valid_until": {"type": "string", "format": "date-time"},
                "version": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "platform_id": {
          "type": "string"
        },
        "strategy_profile": {
          "type": "string"
        },
        "dry_run_only": {
          "type": "boolean"
        },
        "deployment_selector": {
          "type": "string"
        },
        "account_selector": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "account_scope": {
          "type": "string"
        },
        "service_name": {
          "type": "string"
        },
        "execution_mode": {
          "type": "string",
          "enum": ["live", "paper", "dry_run"]
        },
        "market": {
          "type": "string",
          "minLength": 1
        },
        "market_calendar": {
          "type": "string",
          "minLength": 1
        },
        "market_timezone": {
          "type": "string",
          "minLength": 1
        },
        "scheduler": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timezone": {
              "type": "string"
            },
            "main_time": {
              "type": "string"
            },
            "probe_time": {
              "type": "string"
            },
            "precheck_time": {
              "type": "string"
            }
          }
        },
        "execution_windows": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "precheck": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "offset_minutes": {
                  "type": "integer",
                  "minimum": 0
                },
                "mode": {
                  "type": "string",
                  "enum": ["notify_only", "dry_run"]
                }
              }
            },
            "execution": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "offset_minutes": {
                  "type": "integer",
                  "minimum": 0
                },
                "mode": {
                  "type": "string",
                  "enum": ["live", "paper", "dry_run"]
                }
              }
            }
          }
        },
        "strategy_release": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "release_id",
            "manifest_sha256",
            "strategy_revision",
            "config_sha256",
            "risk_policy_sha256",
            "evidence_sha256",
            "plugin_bundle_sha256",
            "effective_session"
          ],
          "properties": {
            "release_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^(sha256:)?[0-9a-fA-F]{64}$"
            },
            "strategy_revision": {
              "type": "string",
              "minLength": 1
            },
            "config_sha256": {
              "type": "string",
              "pattern": "^(sha256:)?[0-9a-fA-F]{64}$"
            },
            "risk_policy_sha256": {
              "type": "string",
              "pattern": "^(sha256:)?[0-9a-fA-F]{64}$"
            },
            "evidence_sha256": {
              "type": "string",
              "pattern": "^(sha256:)?[0-9a-fA-F]{64}$"
            },
            "plugin_bundle_sha256": {
              "type": "string",
              "pattern": "^(sha256:)?[0-9a-fA-F]{64}$"
            },
            "effective_session": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "decision_data": {
          "description": "Public-safe binding summary for frozen strategy decision data; never store provider URLs, credentials, account data, or raw bars here.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "binding_id",
            "binding_sha256",
            "strategy_scope",
            "mode",
            "source_ids",
            "assurance_status"
          ],
          "properties": {
            "binding_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
            },
            "binding_sha256": {
              "type": "string",
              "pattern": "^(sha256:)?[0-9a-fA-F]{64}$"
            },
            "strategy_scope": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
            },
            "mode": {
              "type": "string",
              "enum": ["legacy_runtime_fetch", "artifact_optional", "artifact_required"]
            },
            "source_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
              }
            },
            "as_of": {
              "type": "string",
              "format": "date"
            },
            "adjustment_basis": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
            },
            "artifact_sha256": {
              "type": "string",
              "pattern": "^(sha256:)?[0-9a-fA-F]{64}$"
            },
            "assurance_status": {
              "type": "string",
              "enum": ["LEGACY", "VERIFIED", "DEGRADED", "PARKED"]
            }
          }
        },
        "live_continuity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "baseline_kind",
            "baseline_id",
            "baseline_target_sha256",
            "captured_at"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "ACTIVE_LKG",
                "ACTIVE_REDUCED",
                "RECONCILE_ONLY",
                "RISK_REDUCTION_ONLY",
                "PAUSED",
                "ROLLBACK_LKG"
              ]
            },
            "baseline_kind": {
              "type": "string",
              "enum": ["legacy_authorized", "release_attested"]
            },
            "baseline_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
            },
            "baseline_target_sha256": {
              "type": "string",
              "pattern": "^(sha256:)?[0-9a-fA-F]{64}$"
            },
            "captured_at": {
              "type": "string",
              "format": "date"
            }
          }
        }
      }
    },
    "plugin_mounts_variable": {
      "type": "string"
    },
    "plugin_mounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["strategy", "plugin", "signal_path", "enabled", "expected_mode"],
        "additionalProperties": false,
        "properties": {
          "strategy": {
            "type": "string"
          },
          "plugin": {
            "type": "string"
          },
          "signal_path": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "expected_mode": {
            "type": "string"
          },
          "expected_schema_version": {
            "type": "string"
          }
        }
      }
    },
    "extra_variables": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean", "object", "array", "null"]
      }
    },
    "repository_variables": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean", "object", "array", "null"]
      }
    }
  }
}
