{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qsl.autonomous_operating_policy.v1",
  "title": "QSL Autonomous Operating Policy v1",
  "description": "A signed-policy payload. This schema does not sign a policy, authorize a runtime, or enable orders.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_id", "policy_version", "created_at", "effective_at", "expires_at", "digest_algorithm", "stage", "deployment_bundle", "target", "risk_control", "allowed_ai_actions", "forbidden_ai_actions", "policy_sha256"],
  "properties": {
    "schema": {"const": "qsl.autonomous_operating_policy.v1"},
    "policy_id": {"$ref": "#/$defs/identity"},
    "policy_version": {"$ref": "#/$defs/identity"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "effective_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "digest_algorithm": {"const": "sha256"},
    "stage": {"$ref": "#/$defs/stage"},
    "deployment_bundle": {"$ref": "#/$defs/bundleReference"},
    "target": {"$ref": "#/$defs/target"},
    "risk_control": {"$ref": "#/$defs/riskControl"},
    "allowed_ai_actions": {"type": "array", "items": {"enum": ["evidence_validation", "monitor_readonly", "release_evaluation", "research_candidate_generation"]}},
    "forbidden_ai_actions": {"type": "array", "items": {"enum": ["credential_access", "direct_order_submission", "kill_switch_reset", "policy_mutation", "risk_limit_mutation"]}},
    "policy_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identity": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "stage": {"enum": ["DISABLED", "PAPER_DRY_RUN", "SHADOW", "LIMITED_LIVE", "FULL_LIVE"]},
    "bundleReference": {"type": "object", "additionalProperties": false, "required": ["schema", "bundle_id", "bundle_sha256"], "properties": {"schema": {"const": "qsl.deployment_bundle.v1"}, "bundle_id": {"$ref": "#/$defs/identity"}, "bundle_sha256": {"$ref": "#/$defs/sha256"}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["platform", "repository", "revision", "environment", "account_alias", "account_digest_sha256"], "properties": {"platform": {"$ref": "#/$defs/identity"}, "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$"}, "revision": {"$ref": "#/$defs/revision"}, "environment": {"$ref": "#/$defs/identity"}, "account_alias": {"$ref": "#/$defs/identity"}, "account_digest_sha256": {"$ref": "#/$defs/sha256"}}},
    "riskControl": {"type": "object", "additionalProperties": false, "required": ["risk_policy_id", "risk_policy_version", "risk_policy_sha256"], "properties": {"risk_policy_id": {"$ref": "#/$defs/identity"}, "risk_policy_version": {"$ref": "#/$defs/identity"}, "risk_policy_sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
