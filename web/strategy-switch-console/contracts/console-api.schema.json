{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "inbox": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "ok",
            "partial",
            "read_failed"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "ok",
                  "stale",
                  "unavailable",
                  "read_failed"
                ]
              },
              "failure_reason": {
                "enum": [
                  "kv_list_daily_limit_exceeded"
                ]
              }
            },
            "required": [
              "source",
              "status"
            ]
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title_key": {
                "type": "string"
              },
              "account_alias": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "platform": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "decision_binding": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "category": {
                "enum": [
                  "reconciliation_recovery",
                  "strategy_promotion",
                  "owner_decision",
                  "credential_maintenance",
                  "paper_account_application"
                ]
              },
              "priority": {
                "enum": [
                  "high",
                  "medium",
                  "normal"
                ]
              },
              "created_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "expires_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence_freshness": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string"
                  },
                  "as_of": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "status",
                  "as_of"
                ]
              },
              "status": {
                "enum": [
                  "pending",
                  "decided",
                  "expired"
                ]
              },
              "affects_live": {
                "type": "boolean"
              },
              "diff": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "label_key": {
                      "type": "string"
                    },
                    "before": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    },
                    "after": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    },
                    "affects_live": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "field",
                    "label_key",
                    "before",
                    "after",
                    "affects_live"
                  ]
                }
              },
              "short_id": {
                "type": "string",
                "pattern": "^(IN|CH)-[0-9A-Z]{13}$"
              }
            },
            "required": [
              "id",
              "title_key",
              "account_alias",
              "platform",
              "decision_binding",
              "category",
              "priority",
              "created_at",
              "expires_at",
              "evidence_freshness",
              "status",
              "affects_live",
              "diff",
              "short_id"
            ]
          }
        },
        "coverage": {
          "type": "string"
        },
        "no_order": {
          "const": true
        },
        "execution_authority_granted": {
          "const": false
        }
      },
      "required": [
        "status",
        "sources",
        "items",
        "coverage",
        "no_order",
        "execution_authority_granted"
      ]
    },
    "decision_history": {
      "type": "object",
      "properties": {
        "status": {
          "const": "ok"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item_id": {
                "type": "string"
              },
              "category": {
                "enum": [
                  "reconciliation_recovery",
                  "strategy_promotion",
                  "owner_decision",
                  "credential_maintenance",
                  "paper_account_application"
                ]
              },
              "actor_alias": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "time": {
                "type": "string"
              },
              "action": {
                "enum": [
                  "adopt_intent",
                  "decline_intent"
                ]
              },
              "evidence_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "short_id": {
                "type": "string",
                "pattern": "^(IN|CH)-[0-9A-Z]{13}$"
              },
              "id": {
                "type": "string"
              },
              "item_short_id": {
                "type": "string",
                "pattern": "^IN-[0-9A-Z]{13}$"
              }
            },
            "required": [
              "item_id",
              "category",
              "actor_alias",
              "time",
              "action",
              "evidence_sha256",
              "short_id",
              "id",
              "item_short_id"
            ]
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "coverage": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "items",
        "next_cursor",
        "coverage"
      ]
    },
    "settings_diff": {
      "type": "object",
      "properties": {
        "status": {
