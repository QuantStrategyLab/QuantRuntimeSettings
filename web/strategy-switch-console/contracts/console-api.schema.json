          }
        },
        "no_order": {
          "const": true
        },
        "execution_authority_granted": {
          "const": false
        }
      },
      "required": [
        "status",
        "account_alias",
        "platform",
        "draft_revision",
        "identity_status",
        "rows",
        "no_order",
        "execution_authority_granted"
      ]
    },
    "settings_history": {
