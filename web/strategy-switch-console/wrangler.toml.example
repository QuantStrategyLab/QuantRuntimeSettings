name = "qsl-strategy-switch-console"
main = "worker.js"
compatibility_date = "2026-06-08"
workers_dev = true

# Set these with `wrangler secret put ...` instead of committing values:
# - GITHUB_CLIENT_ID
# - GITHUB_CLIENT_SECRET
# - SESSION_SECRET
# - RUNTIME_SETTINGS_DISPATCH_TOKEN
# - UX1_RESEARCH_JOB_TOKEN  # dedicated UX1 research claim/result bearer; never reuse the dispatch or session token
# - STRATEGY_SWITCH_SYNC_TOKEN  # optional; defaults to RUNTIME_SETTINGS_DISPATCH_TOKEN
# - MARKET_BENCHMARK_SYNC_TOKEN # optional overview market-benchmark ingress; falls back to STRATEGY_SWITCH_SYNC_TOKEN
# - STRATEGY_HEALTH_SYNC_TOKEN  # dedicated outbound health snapshot token; never reuse dispatch token
# - CONTROL_PLANE_SYNC_TOKEN    # dedicated global dashboard snapshot token; never reuse dispatch token
# - RESEARCH_TASK_SYNC_TOKEN    # dedicated immutable research-task source token; never reuse another token
# - RESEARCH_PROMOTION_SYNC_TOKEN # dedicated QPK→console research-promotion ticket ingress; never reuse another token
# - M0_RESEARCH_SYNC_TOKEN      # dedicated read-only M0 research-ledger ingress token; never reuse another token
# - RECONCILIATION_RECOVERY_SYNC_TOKEN # dedicated legacy recovery evidence ingress token; never reuse another token
# - RECONCILIATION_RECOVERY_CONTROLLER_TOKEN # dedicated private recovery-controller read token; never reuse another token
# - ALLOWED_GITHUB_LOGINS
# - ALLOWED_GITHUB_ORGS
# - STRATEGY_SWITCH_ADMIN_LOGINS
# - STRATEGY_SWITCH_ADMIN_ORGS
# - STRATEGY_SWITCH_ACCOUNT_OPTIONS_JSON
#
# Optional non-secret variables can be placed here or in the Cloudflare dashboard.
[vars]
# The deploy workflow renders this from the runtime-strategy-switch Environment value.
# Keep the checked-in default closed; use the Environment value as the deployment source of truth.
ACCOUNT_FACTS_READ_MODEL_ENABLED = "false"
# The deploy workflow renders this from the runtime-strategy-switch Environment value.
# Keep daily runtime read access disabled unless explicitly enabled for deployment.
RUNTIME_DAILY_READ_MODEL_ENABLED = "false"
# Website visibility only; does not disable trading or remove platform support.
# Comma-separated platform IDs. Set to an empty string to show all platforms.
STRATEGY_SWITCH_HIDDEN_PLATFORMS = "qmt"
RUNTIME_SETTINGS_REPO = "QuantStrategyLab/QuantRuntimeSettings"
RUNTIME_SETTINGS_WORKFLOW = "manual-strategy-switch.yml"
RUNTIME_SETTINGS_REF = "main"
# The current source is a once-per-trading-day research lane.
CONTROL_PLANE_STALE_TTL_SECONDS = "129600"
# UX1 async preview stays off unless UX1_PREVIEW_MODE is exactly github_actions.
# Leave it unset to keep the local UX1_RESEARCH_CALCULATOR binding. Placeholders only:
# UX1_PREVIEW_MODE = "github_actions"
# UX1_UES_REVISION = "0123456789abcdef0123456789abcdef01234567"
# UX1_RUNTIME_EPOCH = "0123456789abcdef0123456789abcdef"
# UX1_EXPECTED_EVIDENCE_HASHES = "{\"r7_policy_sha256\":\"64-lowercase-hex\",\"r8_policy_sha256\":\"64-lowercase-hex\",\"capital_policy_sha256\":\"64-lowercase-hex\",\"settlement_policy_sha256\":\"64-lowercase-hex\",\"raw_manifest_sha256\":\"64-lowercase-hex\",\"r6_manifest_sha256\":\"64-lowercase-hex\",\"r6_materialized_file_sha256\":\"64-lowercase-hex\"}"

# Forks can replace the platform repository mapping without editing source code.
# STRATEGY_SWITCH_PLATFORM_REPOSITORIES_JSON = '{"longbridge":"your-org/LongBridgePlatform","ibkr":"your-org/InteractiveBrokersPlatform","schwab":"your-org/CharlesSchwabPlatform","firstrade":"your-org/FirstradePlatform"}'
# STRATEGY_SWITCH_LONGBRIDGE_REPO = "your-org/LongBridgePlatform"
# STRATEGY_SWITCH_IBKR_REPO = "your-org/InteractiveBrokersPlatform"
# STRATEGY_SWITCH_SCHWAB_REPO = "your-org/CharlesSchwabPlatform"
# STRATEGY_SWITCH_FIRSTRADE_REPO = "your-org/FirstradePlatform"

# Cron trigger: refresh KV cache so /api/config never blocks on GitHub API.
# Runs every 5 minutes. Remove this block if you don't need cache warming.
[triggers]
crons = ["*/5 * * * *"]

# Bind this namespace to enable editable /admin login and account management.
# Without it, /admin is read-only and the Worker falls back to secrets.
# [[kv_namespaces]]
# binding = "STRATEGY_SWITCH_CONFIG"
# id = "replace-with-cloudflare-kv-namespace-id"

# Runtime instance drafts use SQLite storage, supported on Workers Free.
# Initialization remains an explicit administrator import. Until then all
# instance writers reject changes and existing execution reads legacy config.
# Do not remove this binding to roll back after import; see the runbook.
[[durable_objects.bindings]]
name = "STRATEGY_SWITCH_RUNTIME_INSTANCES"
class_name = "RuntimeInstances"
[[migrations]]
tag = "runtime-instances-v1"
new_sqlite_classes = ["RuntimeInstances"]
