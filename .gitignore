__pycache__/
.pytest_cache/
.ruff_cache/
.venv/
.wrangler/
local/
.worktrees/

# Local env and Cloudflare runtime (never commit)
.env
.env.*
!.env.example
!*.env.example
.dev.vars
.dev.vars.*
web/strategy-switch-console/wrangler.toml
web/strategy-switch-console/.dev.vars
web/strategy-switch-console/.dev.vars.*

# Private account directory copies (use *.example.json in git only)
**/account-options.json
!**/account-options.example.json
**/strategy-switch-accounts.json
**/private-accounts.json

# Key material and cloud credentials
*.pem
*.key
*.p12
*.pfx
!**/tests/**/*.pem
!**/*.example.pem
*credentials*.json
!*credentials*.example.json
*-sa.json
*service-account*.json
*serviceaccount*.json
secrets/
**/secrets/

# Node
/web/strategy-switch-console/node_modules/
/web/strategy-switch-console/frontend/node_modules/
/web/strategy-switch-console/frontend/dist/

# Keep AI rule files and shared engineering conventions tracked even when a
# personal global ignore excludes Markdown.
!AGENTS.md
!CLAUDE.md
!.github/engineering.md

# Local editor, OS and tool cache files.
.DS_Store

# Section 6 of the organization style guide: notes that must stay out of Git.
.local/
ops-notes/
*.local.md
*.internal.md
out/

# Process notes stay out of the repository, see section 5.
# An audit, a handoff or a review describes one moment; the code moves on and
# the document does not, so what is left behind reads as current long after it
# stopped being true. Commit history is where to look instead. The [Aa]
# spelling is because .gitignore is case-sensitive on some platforms.
*[Aa][Uu][Dd][Ii][Tt]*.md
*[Hh][Aa][Nn][Dd][Oo][Ff][Ff]*.md
*-[Rr][Ee][Vv][Ii][Ee][Ww]-*.md
*_[Rr][Ee][Vv][Ii][Ee][Ww]_*.md
docs/audits/
docs/plans/
docs/handoffs/
docs/superpowers/
